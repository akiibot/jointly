--- /dev/null
+++ b/src/cached-profile-reader.ts
@@ -0,0 +1,16 @@
+import { ProfileStore, type Profile } from "./profile-store.js";
+
+export class CachedProfileReader {
+  private readonly cache = new Map<string, Profile>();
+
+  constructor(private readonly store: ProfileStore) {}
+
+  read(id: string): Profile | undefined {
+    const cached = this.cache.get(id);
+    if (cached) return { ...cached };
+    const profile = this.store.findById(id);
+    if (!profile) return undefined;
+    this.cache.set(id, profile);
+    return { ...profile };
+  }
+}
diff --git a/tests/cached-profile-reader.test.ts b/tests/cached-profile-reader.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/cached-profile-reader.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { CachedProfileReader } from "../src/cached-profile-reader.js";
+import { ProfileStore } from "../src/profile-store.js";
+
+describe("CachedProfileReader", () => {
+  it("returns defensive copies of a cached base profile", () => {
+    const store = new ProfileStore();
+    store.save({ id: "profile-1", displayName: "Ada" });
+    const reader = new CachedProfileReader(store);
+    const first = reader.read("profile-1")!;
+    first.displayName = "tampered";
+    expect(reader.read("profile-1")).toEqual({ id: "profile-1", displayName: "Ada" });
+  });
+});
