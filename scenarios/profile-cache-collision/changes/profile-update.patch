+import { ProfileStore, type Profile } from "./profile-store.js";
+
+export class ProfileService {
+  constructor(private readonly store: ProfileStore) {}
+
+  updateDisplayName(id: string, displayName: string): Profile {
+    const current = this.store.findById(id);
+    if (!current) throw new Error(`Profile not found: ${id}`);
+    if (displayName.trim().length === 0) throw new Error("displayName must not be blank");
+    const updated = { ...current, displayName };
+    this.store.save(updated);
+    return { ...updated };
+  }
+}
diff --git a/tests/profile-service.test.ts b/tests/profile-service.test.ts
