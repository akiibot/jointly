@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { ProfileService } from "../src/profile-service.js";
+import { ProfileStore } from "../src/profile-store.js";
+
+describe("ProfileService", () => {
+  it("updates an existing display name", () => {
+    const store = new ProfileStore();
+    store.save({ id: "profile-1", displayName: "Ada" });
+    const service = new ProfileService(store);
+    expect(service.updateDisplayName("profile-1", "Grace")).toEqual({ id: "profile-1", displayName: "Grace" });
+    expect(store.findById("profile-1")).toEqual({ id: "profile-1", displayName: "Grace" });
+    expect(store.revision("profile-1")).toBe(2);
+  });
+});
