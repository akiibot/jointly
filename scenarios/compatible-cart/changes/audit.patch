+import { Cart, type CartLine } from "./cart.js";
+
+export class AuditedCart {
+  readonly cart = new Cart();
+  private readonly entries: string[] = [];
+
+  addItem(line: CartLine): void {
+    this.cart.addItem(line);
+    this.entries.push(`added:${line.sku}:${line.quantity}`);
+  }
+
+  auditTrail(): string[] {
+    return [...this.entries];
+  }
+}
