{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jointly.local/schemas/intent-contract.json",
  "title": "Jointly IntentContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changeId",
    "goal",
    "requirements",
    "entities",
    "sideEffects",
    "ambiguities"
  ],
  "properties": {
    "changeId": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intentRequirement"
      }
    },
    "entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sideEffects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "intentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "type",
        "entities",
        "sideEffects",
        "observableOutcome",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$"
        },
        "statement": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "business-rule",
            "invariant",
            "negative-case",
            "security",
            "compatibility"
          ]
        },
        "entities": { "$ref": "#/$defs/nonEmptyStringArray" },
        "sideEffects": { "$ref": "#/$defs/nonEmptyStringArray" },
        "observableOutcome": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "excerpt"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "excerpt": { "type": "string", "minLength": 1 }
          }
        },
        "assumptions": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  }
}

